{
  "name": "dnd4e-party-sheet",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "verify:system": "node tools/verify-system-hooks.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run verify:system && npm run build",
    "e2e:smoke": "node --import tsx ../../tools/foundry-e2e/src/run-smoke.ts --module dnd4e-party-sheet",
    "e2e:perf": "node --import tsx ../../tools/foundry-e2e/src/run-perf.ts --module dnd4e-party-sheet",
    "e2e": "npm run build && npm run e2e:smoke && npm run e2e:perf",
    "prepare": "husky",
    "verify-tag-version": "bash scripts/verify-tag-version.sh",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.4.11"
  }
}
